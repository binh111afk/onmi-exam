import React from 'react';
import { ArrowLeft, ArrowRight, BookOpen, CheckCircle2, CircleDashed, Clock } from 'lucide-react';
import type { Course, CourseLesson } from '../types';
import { subjectToSlug } from '../data/mockData';
import { OmlBlockRouter } from '../components/ExamEditor/OmlRenderer/OmlBlockRouter';

interface LessonViewProps {
  course: Course;
  lesson: CourseLesson;
  isCompleted: boolean;
  onBack: () => void;
  onSelectLesson: (courseId: string, lessonId: string) => void;
  onToggleLessonComplete: (lessonId: string) => void;
  onNavigatePath: (path: string) => void;
}

export const LessonView: React.FC<LessonViewProps> = ({ course, lesson, isCompleted, onBack, onSelectLesson, onToggleLessonComplete, onNavigatePath }) => {
  const lessons = course.chapters.flatMap((c) => c.lessons);
  const lessonIdx = lessons.findIndex((l) => l.id === lesson.id);
  const prevLesson = lessonIdx > 0 ? lessons[lessonIdx - 1] : undefined;
  const nextLesson = lessonIdx < lessons.length - 1 ? lessons[lessonIdx + 1] : undefined;
  const practiceSlug = subjectToSlug(course.subject);

  return (
    <div className="max-w-3xl mx-auto px-4 py-8 antialiased" style={{ fontFamily: "'Inter', sans-serif" }}>
      <div className="flex items-center justify-between mb-5">
        <button
          onClick={onBack}
          className="flex items-center gap-1.5 text-xs font-bold text-text-secondary hover:text-primary transition-colors cursor-pointer"
        >
          <ArrowLeft size={14} /> {course.title}
        </button>
        <span className="text-[10px] font-bold text-text-secondary bg-slate-100 px-2 py-1 rounded-md">
          Bài {lessonIdx + 1}/{lessons.length}
        </span>
      </div>

      <header className="bg-white border border-slate-100 rounded-2xl p-6 mb-6">
        <div className="flex items-center gap-2 mb-2">
          {isCompleted && (
            <span className="flex items-center gap-1 text-[9px] font-extrabold text-emerald-700 bg-emerald-100/70 px-2 py-1 rounded-md">
              <CheckCircle2 size={10} /> Đã hoàn thành
            </span>
          )}
          {!isCompleted && (
            <span className="text-[9px] font-extrabold text-text-secondary bg-slate-100 px-2 py-1 rounded-md flex items-center gap-1">
              <CircleDashed size={10} /> Chưa hoàn thành
            </span>
          )}
          <span className="text-[9px] font-extrabold text-primary bg-primary-light px-2 py-1 rounded-md flex items-center gap-1">
            <Clock size={10} /> {lesson.durationMinutes} phút
          </span>
        </div>
        <h1 className="text-xl font-black text-text-primary">{lesson.title}</h1>
      </header>

      <article className="bg-white border border-slate-100 rounded-2xl p-6 mb-6 space-y-4">
        {lesson.blocks.map((block, idx) => (
          <OmlBlockRouter key={idx} block={block} idx={idx} />
        ))}
      </article>

      <section className={`border rounded-2xl p-5 mb-6 ${isCompleted ? 'bg-emerald-50/50 border-emerald-200/60' : 'bg-primary-light border-primary/20'}`}>
        {isCompleted ? (
          <div className="flex flex-wrap items-center justify-between gap-3">
            <div>
              <p className="text-xs font-black text-text-primary flex items-center gap-1.5">
                <CheckCircle2 size={13} className="text-emerald-500" /> Bạn đã hoàn thành bài học.
              </p>
              <p className="text-[10px] text-text-secondary font-medium mt-1">
                Củng cố ngay kiến thức vừa học bằng 10 câu luyện tập.
              </p>
            </div>
            {practiceSlug && (
              <button
                onClick={() => onNavigatePath(`/practice/quick-${practiceSlug}-10`)}
                className="flex items-center gap-1.5 px-4 py-2 bg-primary hover:bg-primary/90 text-white text-[11px] font-bold rounded-xl transition-all duration-200 cursor-pointer"
              >
                <BookOpen size={12} /> Luyện 10 câu
              </button>
            )}
          </div>
        ) : (
          <div className="flex flex-wrap items-center justify-between gap-3">
            <p className="text-xs font-bold text-text-primary">Bạn đã học xong bài này?</p>
            <button
              onClick={() => onToggleLessonComplete(lesson.id)}
              className="flex items-center gap-1.5 px-4 py-2 bg-primary hover:bg-primary/90 text-white text-[11px] font-bold rounded-xl transition-all duration-200 cursor-pointer"
            >
              <CheckCircle2 size={12} /> Đánh dấu hoàn thành
            </button>
          </div>
        )}
      </section>

      <nav className="flex items-stretch gap-3">
        {prevLesson ? (
          <button
            onClick={() => onSelectLesson(course.id, prevLesson.id)}
            className="flex-1 bg-white border border-slate-100 hover:border-primary/30 rounded-2xl p-4 text-left transition-all duration-200 cursor-pointer group"
          >
            <span className="text-[10px] font-bold text-text-secondary flex items-center gap-1">
              <ArrowLeft size={10} /> Bài trước
            </span>
            <p className="text-xs font-bold text-text-primary mt-1 group-hover:text-primary transition-colors truncate">
              {prevLesson.title}
            </p>
          </button>
        ) : (
          <div className="flex-1" />
        )}
        {nextLesson ? (
          <button
            onClick={() => onSelectLesson(course.id, nextLesson.id)}
            className="flex-1 bg-white border border-slate-100 hover:border-primary/30 rounded-2xl p-4 text-right transition-all duration-200 cursor-pointer group"
          >
            <span className="text-[10px] font-bold text-text-secondary flex items-center justify-end gap-1">
              Bài sau <ArrowRight size={10} />
            </span>
            <p className="text-xs font-bold text-text-primary mt-1 group-hover:text-primary transition-colors truncate">
              {nextLesson.title}
            </p>
          </button>
        ) : (
          <div className="flex-1" />
        )}
      </nav>
    </div>
  );
};
